{% extends 'base.html.twig' %}

{% block title %}Événements à venir{% endblock %}

{% block body %}
    <section class="hero" style="background-image: url('{{ asset('images/rock.jpg') }}')">
        <div class="hero-content">
            <span class="hero-kicker">Agenda local</span>
            <h1>Les événements près de chez vous</h1>
            <p>Concerts, conférences, ateliers et sport : trouvez votre prochaine sortie ou proposez la vôtre.</p>
            <a class="btn" href="{{ path('app_event_new') }}">+ Ajouter un événement</a>
        </div>
    </section>

    <div class="section-head">
        <h2>À venir</h2>
        <ul class="legend">
            <li><a class="{% if category is null %}active{% endif %}" href="{{ path('app_home') }}">Toutes</a></li>
            
            <li class="cat-concert"><a class="{% if category == 'concert' %}active{% endif %}" href="{{ path('app_home', {category: 'concert'}) }}">Concert</a></li>
            <li class="cat-conference"><a class="{% if category == 'conference' %}active{% endif %}" href="{{ path('app_home', {category: 'conference'}) }}">Conférence</a></li>
            <li class="cat-atelier"><a class="{% if category == 'atelier' %}active{% endif %}" href="{{ path('app_home', {category: 'atelier'}) }}">Atelier</a></li>
            <li class="cat-sport"><a class="{% if category == 'sport' %}active{% endif %}" href="{{ path('app_home', {category: 'sport'}) }}">Sport</a></li>
        </ul>
    </div>

    <ul class="event-list">
        {% for evenement in evenements %}
            <li class="event-card cat-{{ evenement.category|lower }}">
                <div class="event-media">
                    {# Si on ajoute une imag elle sera affichée sinon on affiche l'image par défaut de la catégorie #}
                    {% if evenement.image %}
                        <img class="event-image" src="{{ asset('uploads/' ~ evenement.image) }}" alt="{{ evenement.titre }}">
                    {% else %}
                        <img class="event-image" src="{{ asset('images/' ~ evenement.category|lower ~ '.jpg') }}" alt="">
                    {% endif %}
                    
                    <div class="event-date">
                        <span class="day">{{ evenement.date|date('d') }}</span>
                        <span class="month">{{ evenement.date|date('M') }}</span>
                    </div>
                    <span class="badge">{{ evenement.category|capitalize }}</span>
                </div>
                
                <h3 class="event-title"><a href="{{ path('app_event_show', {id: evenement.id}) }}">{{ evenement.titre }}</a></h3>
                <span class="muted">{{ evenement.date|date('d/m/Y à H\\hi') }}</span>
            </li>
        {% else %}
            <p class="empty">Aucun événement à venir pour le moment dans cette catégorie.</p>
        {% endfor %}
    </ul>
{% endblock %}