{% extends 'base.html.twig' %} 

{% block title %}Ajouter un événement{% endblock %} 

{% block body %}
    <div class="narrow">
        <a class="back-link" href="{{ path('app_home') }}">← Retour aux événements</a>
        <div class="card">
            <h1>Ajouter un événement</h1>

            {{ form_start(form, {'attr': {'class': 'form'}}) }}
                
                <div>
                    <label for="event_titre" class="required">Titre</label>
                    <input type="text" id="event_titre" name="event[titre]" placeholder="Ex. : Soirée jazz au Kiosque" required>
                </div>
                <div>
                    <label for="event_date" class="required">Date</label>
                    <input type="datetime-local" id="event_date" name="event[date]" required>
                </div>
                <div>
                    <label for="event_informations" class="required">Informations</label>
                    <textarea id="event_informations" name="event[informations]" placeholder="Lieu, programme, tarif..." required></textarea>
                </div>
                <div>
                    <label for="event_category">Catégorie</label>
                    <select id="event_category" name="event[category]">
                        <option value="concert">Concert</option>
                        <option value="conference">Conférence</option>
                        <option value="atelier">Atelier</option>
                        <option value="sport">Sport</option>
                    </select>
                </div>
                <div>
                    <label for="event_NbPlaces">Nombre de places</label>
                    <input type="number" id="event_NbPlaces" name="event[NbPlaces]" min="1" value="20">
                </div>
                <div>
                    <label for="event_image">Image à la une</label>
                    <input type="file" id="event_image" name="event[image]" accept="image/*">
                    <div class="help-text">JPG, PNG ou WebP.</div>
                </div>

                {{ form_row(form._token) }}

                <button type="submit">Enregistrer l'événement</button>
                
            {{ form_end(form, {'render_rest': false}) }}
            
        </div>
    </div>
{% endblock %}